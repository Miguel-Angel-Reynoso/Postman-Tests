    {
      "name": "Create Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Saving Booking ID\", function(){\r\n    var ID = pm.response.json().bookingid;\r\n    pm.environment.set(\"bookingID\", ID);\r\n    console.log(\"Booking ID saved successfully\");\r\n});\r\n\r\npm.test(\"Saving Name\", function(){\r\n    var Name = pm.response.json().booking.firstname;\r\n    pm.environment.set(\"Name\", Name);\r\n    console.log(\"Name saved\");\r\n});\r\n\r\npm.test(\"Validating total price\", function(){\r\n    var totalprice = pm.response.json().booking.totalprice;\r\n    if (totalprice >= 200) {\r\n        console.log(\"Price too high\");\r\n    } else{\r\n        console.log(\"Good price\");\r\n    }\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstname\" : \"{{$randomFirstName}}\",\r\n    \"lastname\" : \"{{$randomLastName}}\",\r\n    \"totalprice\" : 111,\r\n    \"depositpaid\" : true,\r\n    \"bookingdates\" : {\r\n        \"checkin\" : \"2018-01-01\",\r\n        \"checkout\" : \"2019-01-01\"\r\n    },\r\n    \"additionalneeds\" : \"Breakfast\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
